<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Car Marketplace</title>


</head>

<body>

    <%- include('./partials/navbar') %>


    <!-- Hero Section -->
    <section class="hero">

        <!-- Unsplash Background Image -->
        <img id="heroBgImage" src="" alt="Car Marketplace">

        <!-- Dark Overlay -->
        <div class="hero-overlay"></div>


        <!-- Hero Content -->
        <div class="hero-content">

            <h1>Find Your Next Car</h1>

            <p>
                Browse cars from our marketplace.
            </p>

            <a href="/car-listings" class="hero-button">
                Browse Cars
            </a>

        </div>


        <!-- Carousel Buttons -->
        <button id="prevBtn" class="hero-arrow">
            &lt;
        </button>

        <button id="nextBtn" class="hero-arrow">
            &gt;
        </button>

    </section>


    <script>

        const ACCESS_KEY = "<%= process.env.UNSPLASH_ACCESS_KEY %>";

        let carouselImages = [];
        let currentIndex = 0;


        // Get car images from Unsplash
        async function fetchHeroImages() {

            try {

                const response = await fetch(
                    `https://api.unsplash.com/search/photos?query=supercar&per_page=6&client_id=${ACCESS_KEY}`
                );

                const data = await response.json();

                if (data.results && data.results.length > 0) {

                    carouselImages = data.results.map(
                        image => image.urls.regular
                    );

                    updateImage();

                    startAutoSlide();
                }

            } catch (error) {

                console.error(
                    "Failed to load Unsplash images:",
                    error
                );

            }
        }


        // Change the current image
        function updateImage() {

            const imageElement =
                document.getElementById("heroBgImage");

            imageElement.style.opacity = "0";

            setTimeout(() => {

                imageElement.src =
                    carouselImages[currentIndex];

                imageElement.style.opacity = "1";

            }, 400);
        }


        // Automatically change image every 4 seconds
        function startAutoSlide() {

            setInterval(() => {

                currentIndex =
                    (currentIndex + 1) %
                    carouselImages.length;

                updateImage();

            }, 4000);
        }


        // Previous image
        document
            .getElementById("prevBtn")
            .addEventListener("click", () => {

                currentIndex =
                    (currentIndex - 1 +
                    carouselImages.length) %
                    carouselImages.length;

                updateImage();

            });


        // Next image
        document
            .getElementById("nextBtn")
            .addEventListener("click", () => {

                currentIndex =
                    (currentIndex + 1) %
                    carouselImages.length;

                updateImage();

            });


        // Start loading images
        fetchHeroImages();

    </script>

</body>
</html>