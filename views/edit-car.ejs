<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Car</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Edit Car</h1>
                            
 <!--     1--`method-override` converts the POST request into a PUT request.
                    2--enctype="multipart/form-data" → Allows forms to upload files. -->
        <form action="/car-listings/<%= carListing._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

        <label for="streetAddress">Street Address:</label>
        <input type="text" id="streetAddress" name="streetAddress" value="<%= carListing.streetAddress %>" required>

        <label for="brand">Brand:</label>       ///value to The form opens with the existing data
        <input type="text" id="brand" name="brand" value="<%= carListing.brand %>" required>

        <label for="model">Model:</label>
        <input type="text" id="model" name="model" value="<%= carListing.model %>" required>

        <label for="year">Year:</label>
        <input type="number" id="year" name="year" value="<%= carListing.year %>" required>

        <label for="price">Price:</label>
        <input type="number" id="price" name="price" value="<%= carListing.price %>" required>

        <label for="mileage">Mileage:</label>
        <input type="number" id="mileage" name="mileage" value="<%= carListing.mileage %>" required>

        <label for="description">Description:</label>
        
    <textarea id="description" name="description" required><%= carListing.description %></textarea>

          <label for="image">Car Image:</label>
            <input type="file" id="image" name="image" accept="image/*">
<!--             `accept="image/*"` → **Allows users to select image files only.**
 -->

        <button type="submit">Update Car</button>

    </form>

</body>
</html>