<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/style.css">

    <title>Car Details</title>
</head>

<body>

    <%- include('./partials/navbar') %>

    <div class="car-details">

        <div class="car-details-header">
            <h1><%= carListing.brand %> <%= carListing.model %></h1>
        </div>


        <div class="car-details-main">

            <div class="car-image-section">

                <img
                    class="car-details-main-image"
                    src="/uploads/<%= carListing.image %>"
                    alt="Car Image"
                >

            </div>


            <div class="car-info-section">

                <div class="car-info-item">
                    <span>Year</span>
                    <strong><%= carListing.year %></strong>
                </div>

                <div class="car-info-item">
                    <span>Price</span>
                    <strong><%= carListing.price %></strong>
                </div>

                <div class="car-info-item">
                    <span>Mileage</span>
                    <strong><%= carListing.mileage %></strong>
                </div>

                <div class="car-info-item">
                    <span>Location</span>
                    <strong><%= carListing.streetAddress %></strong>
                </div>

            </div>

        </div>


        <div class="car-description">

            <h2>Description</h2>

            <p><%= carListing.description %></p>

        </div>


<!-- Only the owner can edit or delete this car -->
<% if (user && user._id === carListing.owner.toString()) { %>

    <div class="car-actions">

        <a class="btn" href="/car-listings/<%= carListing._id %>/edit">
            Edit Car
        </a>

        <form action="/car-listings/<%= carListing._id %>?_method=DELETE" method="POST">
            <button type="submit">
                Delete Car
            </button>
        </form>

    </div>

<% } %>


        <div class="reviews">

            <h2>Leave a Review</h2>
            <form action="/car-listings/<%= carListing._id %>/reviews"method="POST"class="review-form">

                <label for="reviewBody">Review:</label>

                <textarea id="reviewBody"name="reviewBody"required></textarea>


                <label for="rating">Rating:</label>
                <input type="number"id="rating"name="rating"min="1" max="5" required>


                <button type="submit">Submit Review</button>

            </form>


            <h2>Reviews</h2>

            <!-- to show the reviews and button to delete -->

            <% for (let oneReview of reviews) { %>

                <div class="review">

                    <p class="review-user">
                        <%= oneReview.creator.username %>
                    </p>

                    <p class="review-body">
                        <%= oneReview.reviewBody %>
                    </p>

                    <p class="review-rating">
                        Rating: <%= oneReview.rating %>/5
                    </p>

                    <!-- Only the review creator can delete the review -->                               
                   <% if (user && user._id === oneReview.creator._id.toString()) { %>
                    <form action="/car-listings/<%= carListing._id %>/reviews/<%= oneReview._id %>?_method=DELETE"method="POST">
                        <button type="submit"> Delete Review</button>
                    </form>
                    <% } %>

                </div>

            <% } %>

        </div>

    </div>

</body>
</html>